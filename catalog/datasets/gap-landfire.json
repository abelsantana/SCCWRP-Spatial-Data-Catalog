{
  "id": "gap-landfire",
  "title": "USGS GAP/LANDFIRE land cover",
  "category": "Land cover",
  "provider": "USGS GAP",
  "recommendation": "link-out",
  "versions": {
    "latest": "NTE 2011 v3.0 (final); LANDFIRE EVT LF2025 replaces it",
    "older_versions_online": "Partial (GAP v1.0 2001)",
    "sccwrp_version_online": "Likely yes (NTE 2011 v3.0)"
  },
  "links": [
    {
      "role": "landing",
      "type": "landing",
      "url": "https://www.sciencebase.gov/catalog/item/573cc51be4b0dae0d5e4b0c5"
    },
    {
      "role": "download",
      "type": "web",
      "url": "https://www.sciencebase.gov/catalog/item/592f007de4b0e9bd0ea793c2",
      "label": "state subsets incl. CA"
    },
    {
      "role": "access",
      "type": "arcgis-directory",
      "url": "https://lfps.usgs.gov/arcgis/rest/services",
      "label": "LANDFIRE"
    }
  ],
  "access": {
    "mode": "stream",
    "how": "LANDFIRE ImageServers (EVT, EVC, EVH), clipped by area; GAP NTE 2011 from ScienceBase state subsets"
  },
  "fetch": {
    "default": "evt",
    "layers": {
      "evt": {
        "title": "LANDFIRE Existing Vegetation Type, LF2025 (30 m class codes; successor to GAP land cover)",
        "handler": "arcgis-image",
        "url": "https://lfps.usgs.gov/arcgis/rest/services/Landfire_LF2025/LF2025_EVT_CONUS/ImageServer",
        "version": "LANDFIRE LF2025",
        "resolution": 30,
        "pixel_type": "S16",
        "nodata": -9999,
        "resampling": "nearest"
      },
      "evc": {
        "title": "LANDFIRE Existing Vegetation Cover, LF2025 (30 m class codes)",
        "handler": "arcgis-image",
        "url": "https://lfps.usgs.gov/arcgis/rest/services/Landfire_LF2025/LF2025_EVC_CONUS/ImageServer",
        "version": "LANDFIRE LF2025",
        "resolution": 30,
        "pixel_type": "S16",
        "nodata": -9999,
        "resampling": "nearest"
      },
      "evh": {
        "title": "LANDFIRE Existing Vegetation Height, LF2025 (30 m class codes)",
        "handler": "arcgis-image",
        "url": "https://lfps.usgs.gov/arcgis/rest/services/Landfire_LF2025/LF2025_EVH_CONUS/ImageServer",
        "version": "LANDFIRE LF2025",
        "resolution": 30,
        "pixel_type": "S16",
        "nodata": -9999,
        "resampling": "nearest"
      },
      "evt-2016": {
        "title": "LANDFIRE Existing Vegetation Type, LF2016 Remap (30 m; nearest in time to GAP 2011)",
        "handler": "arcgis-image",
        "url": "https://lfps.usgs.gov/arcgis/rest/services/Landfire_LF2016/LF2016_EVT_CONUS/ImageServer",
        "version": "LANDFIRE LF2016 Remap",
        "resolution": 30,
        "pixel_type": "S16",
        "nodata": -9999,
        "resampling": "nearest"
      }
    }
  },
  "packages": [],
  "other_access": [],
  "notes": "The tools get LANDFIRE, which replaces GAP: 2025 existing vegetation type, cover and height, and the 2016 type (closest to GAP 2011). Results are class codes; read them with the LANDFIRE attribute tables. The GAP 2011 services were unreliable in testing (HTTP 502/503), so GAP itself is download only.",
  "last_reviewed": "2026-09-29"
}
