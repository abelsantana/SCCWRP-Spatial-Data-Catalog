{
  "id": "npdes-outfalls",
  "title": "EPA NPDES outfalls and POTWs",
  "category": "Facilities",
  "provider": "US EPA ECHO / State Water Board",
  "recommendation": "link-out-current",
  "versions": {
    "latest": "Weekly (2026-09-27)",
    "older_versions_online": "No snapshots",
    "sccwrp_version_online": "No (extracts must be re-filtered)"
  },
  "links": [
    {
      "role": "landing",
      "type": "landing",
      "url": "https://echo.epa.gov/tools/data-downloads"
    },
    {
      "role": "download",
      "type": "download",
      "url": "https://echo.epa.gov/files/echodownloads/npdes_outfalls_layer.zip"
    },
    {
      "role": "access",
      "type": "arcgis-directory",
      "url": "https://echogeo.epa.gov/arcgis/rest/services/ECHO"
    }
  ],
  "access": {
    "mode": "stream",
    "how": "EPA ECHO services and weekly outfall layer zip"
  },
  "fetch": {
    "default": "npdes-individual-permits",
    "layers": {
      "npdes-individual-permits": {
        "title": "NPDES individual-permit facilities (ECHO CWA facilities with an individual permit)",
        "handler": "arcgis-features",
        "url": "https://echogeo.epa.gov/arcgis/rest/services/ECHO/Facilities/MapServer/2",
        "where": "CWP_PERMIT_TYPE_DESC = 'NPDES Individual Permit'",
        "version": "ECHO, updated weekly"
      },
      "potws": {
        "title": "Publicly owned treatment works (ECHO CWA facilities flagged POTW)",
        "handler": "arcgis-features",
        "url": "https://echogeo.epa.gov/arcgis/rest/services/ECHO/Facilities/MapServer/2",
        "where": "CWP_FACILITY_TYPE_INDICATOR = 'POTW'",
        "version": "ECHO, updated weekly"
      },
      "cwa-facilities": {
        "title": "All ECHO Clean Water Act facilities (includes general-permit and stormwater sites)",
        "handler": "arcgis-features",
        "url": "https://echogeo.epa.gov/arcgis/rest/services/ECHO/Facilities/MapServer/2",
        "version": "ECHO, updated weekly"
      }
    }
  },
  "packages": [],
  "other_access": [
    "ECHO REST web services"
  ],
  "notes": "SCCWRP-curated ocean outfall coordinates (LACSD, Monitoring) should stay local.",
  "last_reviewed": "2026-09-29"
}
