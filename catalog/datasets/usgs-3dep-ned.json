{
  "id": "usgs-3dep-ned",
  "title": "USGS NED 1/3 arc-second (now 3DEP)",
  "category": "Elevation",
  "provider": "USGS 3DEP",
  "recommendation": "link-out",
  "versions": {
    "latest": "Continuously updated (2025-26 tiles)",
    "older_versions_online": "Yes (historical/ folder)",
